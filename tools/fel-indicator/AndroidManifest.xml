<?xml version="1.0" encoding="utf-8"?>
<!-- FEL indicator: shows "EL off" / "EL on" when the dvfel A/B button switches the EL. No UI, no
     permissions; the module's watcher (video/fel-ab-notify.sh) sends it an explicit broadcast. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.firetvav.felindicator"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />
    <application android:label="FEL indicator" android:hasCode="true" android:allowBackup="false">
        <receiver android:name=".ElReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.firetvav.felindicator.EL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
